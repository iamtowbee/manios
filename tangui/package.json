{
  "name": "@curds/tangui",
  "version": "0.1.0",
  "description": "A game-focused UI library inspired by Tamagui - composable, type-safe, and pixel-perfect",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ui",
    "game",
    "components",
    "typescript",
    "pixel-art",
    "wasm"
  ],
  "author": "Curds.io Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
